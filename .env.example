# Set to "true" on production to show the under-deployment page to visitors.
# Admin (/admin) remains accessible for content updates.
SITE_UNDER_DEPLOYMENT=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Admin panel (set in Vercel for production)
ADMIN_USERNAME=chandan
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Admin saves use ADMIN_SESSION_SECRET via a secure database RPC.
# Required for image uploads, bookings, and direct admin writes — Supabase Dashboard → Settings → API
SUPABASE_SERVICE_ROLE_KEY=
