---
import Layout from "@/layouts/Layout.astro";
---

<Layout
  title="Page Not Found | Jungle Tours & Treks"
  description="The page you are looking for does not exist."
  noIndex={true}
>
  <div class="flex min-h-screen flex-col items-center justify-center bg-surface px-4 text-center">
    <p class="text-[11px] font-semibold uppercase tracking-wider text-cta">404</p>
    <h1 class="mt-2 text-2xl font-bold text-brand-text sm:text-3xl">
      Page not found
    </h1>
    <p class="mt-3 max-w-md text-sm text-brand-muted">
      The trail you followed doesn't lead anywhere. Head back to the homepage to
      keep exploring.
    </p>
    <a
      href="/"
      class="mt-6 rounded-full bg-cta px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-cta-hover"
    >
      Back to home
    </a>
  </div>
</Layout>
